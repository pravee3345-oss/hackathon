PORT=5001
NODE_ENV=development

# REQUIRED in production. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173
# Load browser-extension/ as unpacked, copy its ID from chrome://extensions, then restart.
CORS_EXTENSION_ID=

# AI - GroqCloud is preferred; Gemini is used as a fallback if configured.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Set true to use a separate Playwright browser instead of the current browser.
# Set EXTENSION_PATH to the existing browser-extension directory to load its floating assistant.
ENABLE_PLAYWRIGHT=false
EXTENSION_PATH=
PLAYWRIGHT_USER_DATA_DIR=./data/playwright-profile

SQLITE_PATH=./data/accessease.db
