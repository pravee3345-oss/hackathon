{
  "manifest_version": 3,
  "name": "AccessEase Floating Assistant",
  "version": "1.1.0",
  "description": "Keep the AccessEase assistant available on websites.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "http://localhost:5001/*",
    "http://127.0.0.1:5001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
